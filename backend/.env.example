# Backend (Express) — copy to backend/.env
PORT=5000
NODE_ENV=development

# Required in production; the server refuses to start without it when NODE_ENV=production
JWT_SECRET=

# Frontend origin allowed by CORS, also used to build password-reset links
ALLOWED_ORIGIN=http://localhost:3000

MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/schoolmonitor?retryWrites=true&w=majority

# Same client ID as the frontend — used to verify Google ID tokens
GOOGLE_CLIENT_ID=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail with an App Password (not your normal password)
MAIL_USER=
MAIL_PASS=
MAIL_FROM=SchoolMonitor <you@gmail.com>
